# The repository that holds the wiki content (required). Full URL; the host
# determines the provider: github.com or gitlab.com. For a self-hosted GitLab
# instance, additionally set GIT_PROVIDER=gitlab. An absolute path (e.g.
# /home/me/wiki) serves a local repository directly from disk, with no
# sign-in setup needed; useful for demos and offline use.
GIT_REPO=https://github.com/my-github-orga/wiki
GIT_BRANCH=main
# Optional subdirectory inside the repo that is the OKF bundle root
GIT_ROOT=
# GIT_PROVIDER=gitlab

# Random string used to encrypt the session cookie (e.g. `openssl rand -hex 32`).
# Strongly recommended in production; without it a public fallback secret is
# used and session cookies can be forged.
SESSION_SECRET=

# External origin as users reach it, e.g. https://wiki.example.com. Set this
# behind a reverse proxy so OAuth redirect URIs and absolute links don't rely
# on the client-supplied Host / X-Forwarded-Host headers. Optional locally.
PUBLIC_ORIGIN=

# GitHub sign-in: GitHub App credentials (recommended; create at
# https://github.com/settings/apps/new with Contents read/write permission and
# install it on the wiki repository — or use http://localhost:3000/setup).
# A classic OAuth App from https://github.com/settings/developers also works.
# Callback URL in either case: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab sign-in: OAuth application credentials (create under User/Group
# Settings -> Applications with the "api" scope, confidential, redirect URI
# http://localhost:3000/api/auth/callback).
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
