# GitHub App credentials (recommended; create at https://github.com/settings/apps/new
# with Contents read/write permission and install it on the wiki repository).
# A classic OAuth App from https://github.com/settings/developers also works.
# Callback URL in either case: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string used to encrypt the session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Pin the wiki to one repository for the whole deployment (recommended for
# hosted setups). When set, the repo picker is disabled and users land
# directly on the wiki after signing in. Full repository URL; the host
# determines the provider (currently only github.com).
WIKI_REPO=https://github.com/my-github-orga/wiki
WIKI_BRANCH=main
# Optional subdirectory inside the repo that is the OKF bundle root
WIKI_ROOT=
